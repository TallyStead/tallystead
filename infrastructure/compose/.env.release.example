TALLYSTEAD_VERSION=0.2.2
TALLYSTEAD_IMAGE_REGISTRY=ghcr.io/example-owner
TALLYSTEAD_WEB_IMAGE=ghcr.io/tallystead/tallystead-web:0.2.2
POSTGRES_DB=tallystead
POSTGRES_USER=tallystead
POSTGRES_PASSWORD=replace-with-a-long-local-secret
MINIO_ROOT_USER=tallystead
MINIO_ROOT_PASSWORD=replace-with-a-different-long-local-secret
API_SECRET_KEY=replace-with-another-long-local-secret
PROXY_SHARED_SECRET=replace-with-a-fourth-long-local-secret
TALLYSTEAD_SERVER_HOST=tallystead.home.arpa
TALLYSTEAD_HTTPS_PORT=443
# Space-separated addresses allowed to supply forwarded headers. Leave this
# loopback-only default in place unless a reverse proxy is configured.
TALLYSTEAD_TRUSTED_PROXY_CIDRS=127.0.0.1/32
TALLYSTEAD_FORWARD_AUTH_ENABLED=false
TALLYSTEAD_PROXY_BIND_IP=127.0.0.1
TALLYSTEAD_PROXY_HTTP_PORT=8080
TALLYSTEAD_SESSION_TTL_DAYS=30
TALLYSTEAD_SESSION_IDLE_MINUTES=1440
TALLYSTEAD_BACKUP_AGE_RECIPIENT=
# Zero retains all encrypted backups. Choose a positive count only after setting a retention policy.
TALLYSTEAD_BACKUP_RETENTION_COUNT=0
