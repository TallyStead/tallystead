POSTGRES_DB=tallystead
POSTGRES_USER=tallystead
POSTGRES_PASSWORD=replace-with-a-long-local-secret
MINIO_ROOT_USER=tallystead
MINIO_ROOT_PASSWORD=replace-with-a-long-local-secret
API_SECRET_KEY=replace-with-a-long-local-secret
PROXY_SHARED_SECRET=replace-with-a-different-long-local-secret
TALLYSTEAD_SERVER_HOST=localhost
TALLYSTEAD_HTTPS_PORT=8443
TALLYSTEAD_WEB_IMAGE=ghcr.io/tallystead/tallystead-web:0.2.0
# Used only with compose.public.yaml for intentional HTTP-01/public redirects.
TALLYSTEAD_HTTP_PORT=80
TALLYSTEAD_SESSION_TTL_DAYS=30
TALLYSTEAD_SESSION_IDLE_MINUTES=1440
TALLYSTEAD_BACKUP_AGE_RECIPIENT=
# Zero retains all encrypted backups. Set a positive count only after choosing a retention policy.
TALLYSTEAD_BACKUP_RETENTION_COUNT=0
# The optional HTTP listener is only needed when you intentionally use HTTP-01.
# DNS-01 and TLS-ALPN-01 do not require a host HTTP port here.
